# AutoHeal AI - Server Environment Configuration

PORT=4000
NODE_ENV=development

# Google Gemini API Key for AI Diagnosis (Optional)
# If omitted or invalid, AutoHeal automatically operates in deterministic demo mode.
GEMINI_API_KEY=

# n8n Orchestrator Integration (Optional)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Required for inbound /api/webhooks/:platform event ingestion (generate a long random value).
AUTOHEAL_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Comma-separated trusted browser origins. Keep localhost for the demo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
